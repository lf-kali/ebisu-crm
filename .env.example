# Copie para .env na raiz: `cp .env.example .env`.
# O docker-compose.yml e os apps (api, worker, web) leem este arquivo.
# Valores abaixo são só para desenvolvimento local; nunca reutilize em produção.

# --- Apps ---
API_PORT=3000
WEB_PORT=5173
# Para onde o Vite encaminha /v1 em dev
VITE_API_PROXY=http://localhost:3000

# --- Postgres (docker compose) ---
# Porta 5433 evita conflito com um Postgres nativo na 5432
POSTGRES_PORT=5433
POSTGRES_USER=ebisu
POSTGRES_PASSWORD=ebisu
POSTGRES_DB=ebisu
# Superusuário só para migrações em dev. A F1 cria os papéis ebisu_app (sem BYPASSRLS) e ebisu_auth.
DATABASE_URL=postgresql://ebisu:ebisu@localhost:5433/ebisu

# --- Redis / BullMQ (docker compose) ---
# Porta 6380 evita conflito com um Redis nativo na 6379
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- Armazenamento S3 (SeaweedFS no docker compose) ---
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=ebisu-anexos
S3_ACCESS_KEY_ID=ebisu-dev
S3_SECRET_ACCESS_KEY=ebisu-dev-secret
# SeaweedFS/MinIO exigem path-style (http://host/bucket/chave)
S3_FORCE_PATH_STYLE=true

# --- E-mail (Mailpit no docker compose) ---
SMTP_HOST=localhost
SMTP_PORT=1025
# Interface web do Mailpit: http://localhost:8025
MAILPIT_UI_PORT=8025
