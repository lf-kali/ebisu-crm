# Copie para .env na raiz: `cp .env.example .env`.
# O docker-compose.yml e os apps (api, worker, web) leem este arquivo.
# Valores abaixo são só para desenvolvimento local; nunca reutilize em produção.

# --- Apps ---
API_PORT=3000
WEB_PORT=5173
# Para onde o Vite encaminha /v1 em dev
VITE_API_PROXY=http://localhost:3000
# Por padrão o web fala com a API real (login com os usuários de `pnpm db:seed:demo`, ver README).
# 1 liga a API simulada (MSW) no navegador, para mexer só no front sem API e banco: logins
# ana@demo.test (duas contas) e bruno@demo.test (técnico), senha demo1234. Sem efeito no build.
VITE_API_SIMULADA=
# Acesso ao web por outro host (ex.: tailnet). Lista separada por vírgula; vazio = só localhost.
# Usado por `pnpm dev:tailnet`: o primeiro host é o exposto pelo `tailscale serve`.
WEB_ALLOWED_HOSTS=
# Porta HTTPS do `tailscale serve` (e do HMR no navegador) em `pnpm dev:tailnet`.
TAILNET_HTTPS_PORT=8447

# --- Postgres (docker compose) ---
# Porta 5433 evita conflito com um Postgres nativo na 5432
POSTGRES_PORT=5433
# POSTGRES_USER/PASSWORD/DB só valem na criação do volume; para mudar depois: docker compose down -v
POSTGRES_USER=ebisu
POSTGRES_PASSWORD=ebisu
POSTGRES_DB=ebisu
# Dono das tabelas: só migrações e `pnpm db:papeis`. A aplicação nunca usa esta URL.
DATABASE_URL=postgresql://ebisu:ebisu@localhost:5433/ebisu
# Senhas dos papéis criados pela migração (aplicadas por `pnpm db:papeis`)
DB_APP_PASSWORD=ebisu-app-dev
DB_AUTH_PASSWORD=ebisu-auth-dev
# API e worker: ebisu_app (sem BYPASSRLS, tudo sob RLS por tenant)
DATABASE_URL_APP=postgresql://ebisu_app:ebisu-app-dev@localhost:5433/ebisu
# Módulo de auth: ebisu_auth (usuario/refresh_token e leitura de vínculos no login)
DATABASE_URL_AUTH=postgresql://ebisu_auth:ebisu-auth-dev@localhost:5433/ebisu

# --- Auth (F3) ---
# Chave Ed25519 que assina o access token: gere com `pnpm auth:chaves` e cole as duas linhas
# aqui. Sem ela a API não sobe (nunca há chave padrão).
AUTH_JWT_CHAVE_PRIVADA=
AUTH_JWT_KID=
# Origens do web que podem usar o cookie de refresh (checagem de Origin contra CSRF).
# Separadas por vírgula; inclua a da tailnet se usar `pnpm dev:tailnet` contra a API real.
WEB_ORIGENS=http://localhost:5173

# --- Redis / BullMQ (docker compose) ---
# Porta 6380 evita conflito com um Redis nativo na 6379
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- Armazenamento S3 (SeaweedFS no docker compose) ---
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=ebisu-anexos
# Chave e segredo: só letras, números, '-' e '_' (são gravados no JSON de identidade do SeaweedFS)
S3_ACCESS_KEY_ID=ebisu-dev
S3_SECRET_ACCESS_KEY=ebisu-dev-secret
# SeaweedFS/MinIO exigem path-style (http://host/bucket/chave)
S3_FORCE_PATH_STYLE=true

# --- E-mail (Mailpit no docker compose) ---
SMTP_HOST=localhost
SMTP_PORT=1025
# Interface web do Mailpit: http://localhost:8025
MAILPIT_UI_PORT=8025
