{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@ebisu/db#typecheck": {
      "dependsOn": ["build"]
    },
    "@ebisu/db#test": {
      "dependsOn": ["build"]
    },
    "@ebisu/db#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["WEB_*", "VITE_*"]
    }
  }
}
