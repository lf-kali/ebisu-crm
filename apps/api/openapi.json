{
  "openapi": "3.1.0",
  "info": {
    "title": "ebisuCRM API",
    "version": "1.0.0",
    "description": "API REST /v1 do ebisuCRM"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RespostaSessao": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 1
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expira_em": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Validade do access token em segundos (900 = 15 min, D-T05)"
          },
          "conta": {
            "type": "object",
            "properties": {
              "tenant_id": {
                "$ref": "#/components/schemas/Uuid"
              },
              "nome": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [
              "tenant_id",
              "nome",
              "slug"
            ],
            "description": "Conta desta sessão"
          },
          "contas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResumoConta"
            },
            "minItems": 1,
            "description": "Todas as contas ativas do usuário, incluindo a da sessão"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expira_em",
          "conta",
          "contas"
        ]
      },
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "description": "Identificador UUID"
      },
      "ResumoConta": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "nome": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "nome",
          "slug"
        ],
        "description": "Conta (tenant) da qual o usuário é membro ativo"
      },
      "Problema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI do tipo de erro"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "$ref": "#/components/schemas/CodigoErro"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "invariante": {
            "type": "string",
            "description": "ID da regra violada, ex.: EST-6"
          },
          "campos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErroCampo"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "additionalProperties": {},
        "description": "Erro no formato RFC 9457; códigos podem trazer campos extras (ex.: estado_atual)"
      },
      "CodigoErro": {
        "type": "string",
        "enum": [
          "nao_autenticado",
          "sem_permissao",
          "empresa_nao_autorizada",
          "nao_encontrado",
          "validacao",
          "idempotencia_divergente",
          "idempotencia_em_andamento",
          "conflito_versao",
          "duplicado",
          "transicao_invalida",
          "requisitos_pendentes",
          "estoque_insuficiente",
          "orcamento_imutavel",
          "link_invalido",
          "limite_excedido",
          "erro_interno"
        ]
      },
      "ErroCampo": {
        "type": "object",
        "properties": {
          "campo": {
            "type": "string",
            "description": "Caminho do campo, ex.: itens.0.quantidade"
          },
          "code": {
            "type": "string",
            "description": "Código da validação, ex.: invalid_type"
          },
          "mensagem": {
            "type": "string"
          }
        },
        "required": [
          "campo",
          "code",
          "mensagem"
        ]
      },
      "EntradaLogin": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "senha": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "senha"
        ]
      },
      "EntradaTrocarConta": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "$ref": "#/components/schemas/Uuid"
          }
        },
        "required": [
          "tenant_id"
        ]
      },
      "RespostaEu": {
        "type": "object",
        "properties": {
          "usuario": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid"
              },
              "nome": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "avatar_url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "nome",
              "email",
              "avatar_url"
            ]
          },
          "membro": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid"
              },
              "cargo": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "cargo"
            ]
          },
          "conta": {
            "$ref": "#/components/schemas/ResumoConta"
          },
          "empresas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmpresaDoMembro"
            },
            "description": "Empresas ativas em que o membro tem papel; o valor de X-Empresa-Id deve ser uma delas"
          }
        },
        "required": [
          "usuario",
          "membro",
          "conta",
          "empresas"
        ]
      },
      "EmpresaDoMembro": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "nome_fantasia": {
            "type": "string"
          },
          "razao_social": {
            "type": "string"
          },
          "logo_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "permissoes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/EscopoPermissao"
            },
            "description": "Permissões efetivas nesta empresa (união dos papéis atribuídos a ela e dos atribuídos a todas as empresas, com o maior escopo)"
          }
        },
        "required": [
          "id",
          "nome_fantasia",
          "razao_social",
          "logo_url",
          "permissoes"
        ]
      },
      "EscopoPermissao": {
        "type": "string",
        "enum": [
          "PROPRIO",
          "EMPRESA",
          "TENANT"
        ],
        "description": "PROPRIO = só onde é responsável; EMPRESA = esta empresa; TENANT = todas"
      },
      "RespostaSaude": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/auth/login": {
      "post": {
        "summary": "Entra com e-mail e senha",
        "description": "Abre a sessão na conta usada por último. O refresh token vai só no cookie httpOnly.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntradaLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaSessao"
                }
              }
            }
          },
          "default": {
            "description": "Erro no formato RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "Encerra a sessão (revoga o refresh)",
        "tags": [
          "auth"
        ],
        "responses": {
          "204": {
            "description": "Sucesso, sem conteúdo"
          },
          "default": {
            "description": "Erro no formato RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "summary": "Renova a sessão pelo cookie de refresh (rotativo)",
        "description": "Reusar um refresh token já trocado revoga a família inteira da sessão.",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaSessao"
                }
              }
            }
          },
          "default": {
            "description": "Erro no formato RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/trocar-conta": {
      "post": {
        "summary": "Troca a sessão para outra conta do usuário",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntradaTrocarConta"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaSessao"
                }
              }
            }
          },
          "401": {
            "description": "Erro no formato RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "default": {
            "description": "Erro no formato RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/eu": {
      "get": {
        "summary": "Quem está logado, em qual conta e o que pode em cada empresa",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaEu"
                }
              }
            }
          },
          "401": {
            "description": "Erro no formato RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "default": {
            "description": "Erro no formato RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/saude": {
      "get": {
        "summary": "Verifica se a API está no ar",
        "tags": [
          "plataforma"
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaSaude"
                }
              }
            }
          },
          "default": {
            "description": "Erro no formato RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
