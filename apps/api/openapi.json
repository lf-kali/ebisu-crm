{
  "openapi": "3.1.0",
  "info": {
    "title": "ebisuCRM API",
    "version": "1.0.0",
    "description": "API REST /v1 do ebisuCRM"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "RespostaSaude": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Problema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI do tipo de erro"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "$ref": "#/components/schemas/CodigoErro"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "invariante": {
            "type": "string",
            "description": "ID da regra violada, ex.: EST-6"
          },
          "campos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErroCampo"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "additionalProperties": {},
        "description": "Erro no formato RFC 9457; códigos podem trazer campos extras (ex.: estado_atual)"
      },
      "CodigoErro": {
        "type": "string",
        "enum": [
          "nao_autenticado",
          "sem_permissao",
          "empresa_nao_autorizada",
          "nao_encontrado",
          "validacao",
          "idempotencia_divergente",
          "idempotencia_em_andamento",
          "conflito_versao",
          "duplicado",
          "transicao_invalida",
          "requisitos_pendentes",
          "estoque_insuficiente",
          "orcamento_imutavel",
          "link_invalido",
          "limite_excedido",
          "erro_interno"
        ]
      },
      "ErroCampo": {
        "type": "object",
        "properties": {
          "campo": {
            "type": "string",
            "description": "Caminho do campo, ex.: itens.0.quantidade"
          },
          "code": {
            "type": "string",
            "description": "Código da validação, ex.: invalid_type"
          },
          "mensagem": {
            "type": "string"
          }
        },
        "required": [
          "campo",
          "code",
          "mensagem"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/saude": {
      "get": {
        "summary": "Verifica se a API está no ar",
        "tags": [
          "plataforma"
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaSaude"
                }
              }
            }
          },
          "default": {
            "description": "Erro no formato RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
