// =============================================================================
// ebisuCRM — Modelo de dados v0.2-MVP
// -----------------------------------------------------------------------------
// Evolução da v0.1 (docs/historico/schema-v0.1.prisma) conforme
// docs/consolidacao-revisoes.md. Regras de negócio em docs/invariantes.md.
//
// Convenções
// - PostgreSQL 16. IDs UUIDv7. Nomes em português, snake_case.
// - tenant_id em toda tabela de negócio (RLS: tenant_id = current_setting('app.tenant_id')).
// - empresa_id nos dados que pertencem a um CNPJ.
// - INTEGRIDADE ENTRE EMPRESAS: toda relação de negócio usa FK COMPOSTA
//   (tenant_id, empresa_id) → empresa e (empresa_id, x_id) → x. Assim é
//   impossível, no banco, ligar uma OS da empresa A a um contato da empresa B.
//   Relações opcionais compostas usam onDelete: Restrict (SetNull anularia empresa_id).
// - Dinheiro Decimal(14,2); quantidade Decimal(14,3).
// - Soft delete (deleted_at) nas entidades apagáveis pela UI.
// - Ledgers e históricos são append-only; correção = novo registro (estorno).
// - Trava otimista: versao_registro em orçamento e OS (UPDATE ... WHERE versao_registro = $v).
// - Única referência genérica (entidade_tipo + entidade_id): audit_log.
// - Constraints que o Prisma não expressa (CHECK, índices parciais, RLS) estão
//   em docs/invariantes.md §7 e vão para migrações SQL.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 1. PLATAFORMA — tenancy, empresas, usuários, RBAC
// =============================================================================

enum StatusTenant {
  TRIAL
  ATIVO
  SUSPENSO
  CANCELADO
}

/// Assinante da plataforma (ex.: uma rede de assistências).
model Tenant {
  id         String       @id @default(uuid(7)) @db.Uuid
  nome       String
  slug       String       @unique
  plano      String       @default("free")
  status     StatusTenant @default(TRIAL)
  config     Json         @default("{}")
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  empresas        Empresa[]
  membros         Membro[]
  refresh_tokens  RefreshToken[]
  papeis          Papel[]
  tipos_acessorio TipoAcessorio[]
  checklists      ChecklistModelo[]
  idempotencias   IdempotenciaRequisicao[]
  convites        Convite[]
  emails_saida    EmailSaida[]

  @@map("tenant")
}

/// Empresa = CNPJ. Controladora LGPD dos dados de clientes e dona do estoque.
/// config: validade_orcamento_dias, garantia_padrao_dias, prazo_padrao_dias,
///         pesos de scoring (P1), horário de envio de notificações etc.
model Empresa {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenant_id     String    @db.Uuid
  razao_social  String
  nome_fantasia String
  cnpj          String?
  inscricao_est String?
  email         String?
  telefone      String?
  endereco      Json? /// {cep, logradouro, numero, complemento, bairro, cidade, uf}
  logo_url      String?
  timezone      String    @default("America/Sao_Paulo")
  moeda         String    @default("BRL")
  config        Json      @default("{}")
  ativo         Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  atribuicoes     AtribuicaoPapel[]
  api_keys        ApiKey[]
  sequencias      SequenciaDocumento[]
  contatos        Contato[]
  origens         OrigemLead[]
  capturas        CapturaLead[]
  consentimentos  Consentimento[]
  funis           Funil[]
  negocios        Negocio[]
  motivos_perda   MotivoPerda[]
  atividades      Atividade[]
  tarefas         Tarefa[]
  dispositivos    Dispositivo[]
  proprietarios   DispositivoProprietario[]
  eventos_disp    DispositivoEvento[]
  acessorios      AcessorioRecebido[]
  inspecoes       Inspecao[]
  orcamentos      Orcamento[]
  orcamento_itens OrcamentoItem[]
  ordens_servico  OrdemServico[]
  os_itens        OrdemServicoItem[]
  anexos          Anexo[]
  fornecedores    Fornecedor[]
  itens           Item[]
  compras         Compra[]
  compra_itens    CompraItem[]
  movimentos      MovimentoEstoque[]
  titulos         TituloFinanceiro[]
  pagamentos      Pagamento[]
  modelos_msg     ModeloMensagem[]
  notificacoes    Notificacao[]
  jobs_lote       JobLote[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, cnpj])
  @@index([tenant_id])
  @@map("empresa")
}

/// Identidade global (um e-mail pode participar de vários tenants).
model Usuario {
  id                  String    @id @default(uuid(7)) @db.Uuid
  /// Normalizado (trim + minúsculas): CHECK usuario_email_normalizado na migração.
  email               String    @unique
  nome                String
  telefone            String?
  senha_hash          String?
  /// null: ninguém provou ser dono do e-mail (o cadastro não confirma). O convite (F3-4b), que
  /// chega por e-mail, prova; se o usuário não estava verificado, o convite assume o e-mail.
  email_verificado_em DateTime?
  avatar_url          String?
  ultimo_login        DateTime?
  ativo               Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  membros        Membro[]
  refresh_tokens RefreshToken[]

  @@map("usuario")
}

model RefreshToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  usuario_id  String    @db.Uuid
  /// Conta da sessão (F3): o refresh mantém a conta; NULL só em linhas anteriores à F3.
  tenant_id   String?   @db.Uuid
  token_hash  String    @unique
  familia     String    @db.Uuid /// rotação: reuso detectado invalida a família
  user_agent  String?
  ip          String?
  expira_em   DateTime
  revogado_em DateTime?
  created_at  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  tenant  Tenant? @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([usuario_id, created_at])
  @@index([familia])
  @@map("refresh_token")
}

enum StatusMembro {
  CONVIDADO
  ATIVO
  SUSPENSO
}

/// Vínculo usuário ↔ tenant. É o "ator" referenciado em todo o sistema.
model Membro {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenant_id  String       @db.Uuid
  usuario_id String       @db.Uuid
  status     StatusMembro @default(CONVIDADO)
  cargo      String?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  tenant  Tenant  @relation(fields: [tenant_id], references: [id])
  usuario Usuario @relation(fields: [usuario_id], references: [id])

  atribuicoes AtribuicaoPapel[]
  contatos    Contato[]         @relation("ContatoResponsavel")
  negocios    Negocio[]         @relation("NegocioResponsavel")
  tarefas     Tarefa[]          @relation("TarefaResponsavel")
  ordens_tec  OrdemServico[]    @relation("OSTecnico")

  @@unique([tenant_id, usuario_id])
  @@unique([tenant_id, id])
  @@map("membro")
}

/// Papéis padrão (sistema=true, semeados por tenant): OWNER, ADMIN, GERENTE,
/// ATENDENTE, TECNICO, ESTOQUISTA, FINANCEIRO. Editor de papéis = P1.
model Papel {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenant_id  String   @db.Uuid
  chave      String
  nome       String
  descricao  String?
  sistema    Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenant_id], references: [id])
  permissoes  PapelPermissao[]
  atribuicoes AtribuicaoPapel[]

  @@unique([tenant_id, chave])
  @@unique([tenant_id, id])
  @@map("papel")
}

/// Catálogo fixo `recurso.acao`: lead.create, lead.bulk_delete, os.change_status,
/// estoque.ajuste, financeiro.ver_custos, config.rbac …
model Permissao {
  chave     String @id
  recurso   String
  acao      String
  descricao String

  papeis PapelPermissao[]

  @@map("permissao")
}

enum EscopoPermissao {
  PROPRIO /// só registros em que é responsável/técnico
  EMPRESA /// todos os registros da(s) empresa(s) atribuída(s)
  TENANT /// todas as empresas do tenant
}

model PapelPermissao {
  papel_id        String          @db.Uuid
  permissao_chave String
  escopo          EscopoPermissao @default(EMPRESA)

  papel     Papel     @relation(fields: [papel_id], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissao_chave], references: [chave])

  @@id([papel_id, permissao_chave])
  @@map("papel_permissao")
}

/// Papel do membro em uma empresa (empresa_id nulo = todas as empresas do tenant).
model AtribuicaoPapel {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenant_id  String   @db.Uuid
  membro_id  String   @db.Uuid
  papel_id   String   @db.Uuid
  empresa_id String?  @db.Uuid
  created_at DateTime @default(now())

  membro  Membro   @relation(fields: [tenant_id, membro_id], references: [tenant_id, id], onDelete: Cascade)
  papel   Papel    @relation(fields: [tenant_id, papel_id], references: [tenant_id, id], onDelete: Cascade)
  empresa Empresa? @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([membro_id, papel_id, empresa_id])
  @@map("atribuicao_papel")
}

/// Chaves para integrações máquina-a-máquina (formulários do site, n8n…).
model ApiKey {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenant_id    String    @db.Uuid
  empresa_id   String    @db.Uuid
  nome         String
  prefixo      String    @unique /// exibido: ebk_live_ab12…
  hash         String
  escopos      String[] /// ex.: ["lead.create", "lead.update"]
  origens_cors String[] /// domínios autorizados a usar /public/*
  ultimo_uso   DateTime?
  expira_em    DateTime?
  revogada_em  DateTime?
  criado_por   String?   @db.Uuid
  created_at   DateTime  @default(now())

  empresa Empresa @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])

  @@map("api_key")
}

enum TipoDocumentoSequencia {
  ORCAMENTO
  ORDEM_SERVICO
  COMPRA
}

/// Numeração humana por empresa (Ogun: "ORC-{DD}{MM}{YY}-{####}").
/// Incremento via UPDATE … SET proximo = proximo + 1 RETURNING (lock de linha).
model SequenciaDocumento {
  id         String                 @id @default(uuid(7)) @db.Uuid
  tenant_id  String                 @db.Uuid
  empresa_id String                 @db.Uuid
  tipo       TipoDocumentoSequencia
  formato    String /// ex.: "OS-{YY}{MM}-{####}"
  periodo    String                 @default("") /// chave de reinício (ex.: "2610")
  proximo    Int                    @default(1)

  empresa Empresa @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])

  @@unique([empresa_id, tipo, periodo])
  @@map("sequencia_documento")
}

/// Append-only. Única tabela com referência genérica: só recebe INSERT,
/// é lida apenas pela API e já carrega empresa_id para escopo/RLS.
model AuditLog {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenant_id       String   @db.Uuid
  empresa_id      String?  @db.Uuid
  ator_membro_id  String?  @db.Uuid
  ator_api_key_id String?  @db.Uuid
  entidade_tipo   String
  entidade_id     String   @db.Uuid
  acao            String /// create | update | delete | status_change | bulk_* | anonimizar
  diff            Json?
  ip              String?
  request_id      String?
  ocorreu_em      DateTime @default(now())

  @@index([tenant_id, entidade_tipo, entidade_id])
  @@index([tenant_id, ocorreu_em])
  @@map("audit_log")
}

enum StatusIdempotencia {
  EM_PROCESSAMENTO
  CONCLUIDA
}

/// Guarda o resultado de POSTs com Idempotency-Key. Repetição com o mesmo
/// hash devolve a resposta salva; hash diferente → 422; EM_PROCESSAMENTO → 409.
/// Convite para entrar na conta (F3-4b2; plano docs/planos/f3-4b2-convites.md). O token do link
/// só existe como hash, gerado pelo worker no envio; um uso; vence em 7 dias. Um convite pendente
/// por e-mail na conta (índice parcial convite_pendente_uq na migração).
model Convite {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenant_id     String    @db.Uuid
  /// Normalizado (trim + minúsculas), como usuario.email.
  email         String
  /// [{papel_id, empresa_id | null}], revalidadas no aceite.
  atribuicoes   Json
  /// Membro que convidou (sem FK: o convite sobrevive à saída de quem convidou).
  convidado_por String?   @db.Uuid
  /// SHA-256 (hex) do token do último envio; null antes do envio e depois de reenviar ou revogar.
  token_hash    String?   @unique
  expira_em     DateTime
  aceito_em     DateTime?
  revogado_em   DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  tenant Tenant       @relation(fields: [tenant_id], references: [id])
  emails EmailSaida[]

  @@unique([tenant_id, id])
  @@index([tenant_id, email])
  @@map("convite")
}

enum TipoEmailSaida {
  CONVITE
}

enum StatusEmailSaida {
  PENDENTE
  ENVIANDO
  ENVIADO
  FALHOU
  CANCELADO
}

/// Outbox mínimo de e-mails do sistema (F3-4b2). Guarda o tipo e a referência, nunca o conteúdo
/// nem o token: o worker monta a mensagem no envio. Reivindicado por reivindicar_email_saida().
model EmailSaida {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenant_id  String           @db.Uuid
  tipo       TipoEmailSaida
  convite_id String?          @db.Uuid
  status     StatusEmailSaida @default(PENDENTE)
  tentativas Int              @default(0)
  /// PENDENTE: quando pode sair; ENVIANDO: fim do prazo do worker que a reivindicou. Em UTC, como
  /// a comparação de reivindicar_email_saida(), qualquer que seja o timezone da sessão.
  proxima_em DateTime         @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)"))
  erro       String?
  enviado_em DateTime?
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  tenant  Tenant   @relation(fields: [tenant_id], references: [id])
  convite Convite? @relation(fields: [tenant_id, convite_id], references: [tenant_id, id], onDelete: Cascade)

  @@index([status, proxima_em])
  @@map("email_saida")
}

model IdempotenciaRequisicao {
  tenant_id    String             @db.Uuid
  chave        String
  rota         String
  hash_payload String
  status       StatusIdempotencia @default(EM_PROCESSAMENTO)
  status_http  Int?
  resposta     Json?
  criado_em    DateTime           @default(now())
  expira_em    DateTime

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@id([tenant_id, chave])
  @@index([expira_em])
  @@map("idempotencia_requisicao")
}

// =============================================================================
// 2. CRM / PROSPECÇÃO
// =============================================================================

enum TipoPessoa {
  PF
  PJ
}

enum CanalComunicacao {
  WHATSAPP
  EMAIL
  SMS
}

/// Lifecycle da pessoa — DERIVADO dos negócios/OS pelo serviço de domínio,
/// nunca editado à mão (ver invariantes CRM-2).
enum CicloVida {
  LEAD
  LEAD_QUALIFICADO
  OPORTUNIDADE
  CLIENTE
  RECORRENTE
  INATIVO
}

enum Temperatura {
  FRIO
  MORNO
  QUENTE
}

/// Quadrante Fit × Engajamento — "o que faço com este lead agora?"
enum QuadranteLead {
  PRONTO_PARA_COMPRAR /// fit alto + engajamento alto → fechar já
  CULTIVAR /// fit alto + engajamento baixo → nutrir agora
  PROSPECTAR /// fit baixo + engajamento alto → completar perfil
  TRABALHAR_DEPOIS /// fit baixo + engajamento baixo → baixa prioridade
}

/// Lead e cliente são a MESMA entidade. Campos de inteligência são calculados
/// por regras no código (versão em score_regras_versao) e explicados em score_motivos.
model Contato {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenant_id         String            @db.Uuid
  empresa_id        String            @db.Uuid
  tipo_pessoa       TipoPessoa        @default(PF)
  nome              String
  documento         String?
  email             String?
  email_normalizado String?
  telefone_e164     String?
  whatsapp_e164     String?
  canal_preferido   CanalComunicacao?
  data_nascimento   DateTime?         @db.Date
  endereco          Json?
  ciclo_vida        CicloVida         @default(LEAD)
  origem_id         String?           @db.Uuid
  responsavel_id    String?           @db.Uuid

  // --- inteligência (somente o serviço de scoring escreve) ---
  score_fit           Int           @default(0) /// 0–50
  score_engajamento   Int           @default(0) /// 0–50, decaimento calculado na hora
  score_total         Int           @default(0)
  temperatura         Temperatura   @default(FRIO)
  quadrante           QuadranteLead @default(TRABALHAR_DEPOIS)
  completude_perfil   Int           @default(0) /// % de requisitos atendidos
  campos_faltantes    String[] /// ex.: ["dispositivo", "canal_preferido"]
  score_motivos       Json          @default("[]") /// [{regra, dimensao, pontos, motivo}]
  score_regras_versao String?
  score_calculado_em  DateTime?
  nba_adiada_ate      DateTime? /// próxima ação "lembrar depois"
  ultima_interacao_em DateTime?
  convertido_em       DateTime?
  ltv                 Decimal       @default(0) @db.Decimal(14, 2)

  observacoes    String?
  anonimizado_em DateTime? /// LGPD: dados pessoais zerados, UUID preservado
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  empresa     Empresa     @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  origem      OrigemLead? @relation(fields: [empresa_id, origem_id], references: [empresa_id, id], onDelete: Restrict)
  responsavel Membro?     @relation("ContatoResponsavel", fields: [tenant_id, responsavel_id], references: [tenant_id, id], onDelete: Restrict)

  capturas       CapturaLead[]
  consentimentos Consentimento[]
  negocios       Negocio[]
  atividades     Atividade[]
  tarefas        Tarefa[]
  propriedades   DispositivoProprietario[]
  dispositivos   Dispositivo[]
  orcamentos     Orcamento[]
  ordens_servico OrdemServico[]
  titulos        TituloFinanceiro[]
  notificacoes   Notificacao[]
  anexos         Anexo[]

  // dedupe: índices ÚNICOS PARCIAIS (WHERE deleted_at IS NULL) na migração SQL
  @@unique([empresa_id, id])
  @@index([empresa_id, email_normalizado])
  @@index([empresa_id, telefone_e164])
  @@index([empresa_id, whatsapp_e164])
  @@index([empresa_id, quadrante, score_total])
  @@index([empresa_id, ciclo_vida])
  @@map("contato")
}

enum TipoOrigem {
  FORMULARIO_SITE
  ORCAMENTO_ONLINE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  GOOGLE_ADS
  INDICACAO
  BALCAO
  TELEFONE
  IMPORTACAO
  MANUAL
  OUTRO
}

model OrigemLead {
  id         String     @id @default(uuid(7)) @db.Uuid
  tenant_id  String     @db.Uuid
  empresa_id String     @db.Uuid
  nome       String
  tipo       TipoOrigem
  ativo      Boolean    @default(true)

  empresa  Empresa       @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  contatos Contato[]
  capturas CapturaLead[]

  @@unique([empresa_id, nome])
  @@unique([empresa_id, id])
  @@map("origem_lead")
}

enum StatusCaptura {
  RECEBIDA
  PROCESSADA
  DUPLICADA /// mesclada em contato existente
  REJEITADA
}

/// Cada toque de entrada (form, orçamento online, msg WhatsApp…), bruto + atribuição.
/// Também é fonte de eventos de engajamento para o scoring.
model CapturaLead {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenant_id       String        @db.Uuid
  empresa_id      String        @db.Uuid
  contato_id      String?       @db.Uuid
  origem_id       String?       @db.Uuid
  evento          String /// form_contato | orcamento_iniciado | orcamento_abandonado | mensagem_recebida
  payload         Json
  utm_source      String?
  utm_medium      String?
  utm_campaign    String?
  utm_term        String?
  utm_content     String?
  landing_page    String?
  referrer        String?
  ip              String?
  user_agent      String?
  idempotency_key String?
  status          StatusCaptura @default(RECEBIDA)
  erro            String?
  recebido_em     DateTime      @default(now())

  empresa Empresa     @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  contato Contato?    @relation(fields: [empresa_id, contato_id], references: [empresa_id, id], onDelete: Restrict)
  origem  OrigemLead? @relation(fields: [empresa_id, origem_id], references: [empresa_id, id], onDelete: Restrict)

  @@unique([empresa_id, idempotency_key])
  @@index([empresa_id, recebido_em])
  @@index([contato_id, recebido_em])
  @@map("captura_lead")
}

enum FinalidadeConsentimento {
  TRANSACIONAL /// avisos de orçamento/OS (base legal: execução de contrato)
  MARKETING /// ofertas, nutrição (base legal: consentimento)
}

/// LGPD — prova de consentimento/opt-out por canal e finalidade (append-only:
/// revogação = novo registro com concedido=false).
model Consentimento {
  id          String                  @id @default(uuid(7)) @db.Uuid
  tenant_id   String                  @db.Uuid
  empresa_id  String                  @db.Uuid
  contato_id  String                  @db.Uuid
  canal       CanalComunicacao
  finalidade  FinalidadeConsentimento
  concedido   Boolean
  base_legal  String /// consentimento | execucao_contrato | legitimo_interesse
  evidencia   Json? /// texto exibido, ip, url, captura_id
  coletado_em DateTime                @default(now())

  empresa Empresa @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  contato Contato @relation(fields: [empresa_id, contato_id], references: [empresa_id, id], onDelete: Cascade)

  @@index([contato_id, canal, finalidade, coletado_em])
  @@map("consentimento")
}

/// MVP: um funil padrão por empresa (nomes/ordem editáveis). Múltiplos funis = P1.
model Funil {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenant_id  String   @db.Uuid
  empresa_id String   @db.Uuid
  nome       String
  padrao     Boolean  @default(false)
  ativo      Boolean  @default(true)
  created_at DateTime @default(now())

  empresa  Empresa      @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  etapas   EtapaFunil[]
  negocios Negocio[]

  @@unique([empresa_id, id])
  @@map("funil")
}

enum TipoEtapa {
  ABERTA
  GANHO
  PERDIDO
  NUTRICAO
}

/// Padrão: Novo contato → Qualificação → Diagnóstico/Orçamento →
/// Orçamento enviado → Negociação → Ganho | Perdido | Nutrição.
model EtapaFunil {
  id            String    @id @default(uuid(7)) @db.Uuid
  funil_id      String    @db.Uuid
  nome          String
  ordem         Int
  tipo          TipoEtapa @default(ABERTA)
  probabilidade Int       @default(0)
  sla_horas     Int? /// negócio parado além disso entra na fila de próximas ações
  cor           String?

  funil      Funil            @relation(fields: [funil_id], references: [id], onDelete: Cascade)
  requisitos RequisitoEtapa[]
  negocios   Negocio[]

  @@unique([funil_id, ordem])
  @@unique([funil_id, id])
  @@map("etapa_funil")
}

enum TipoRequisito {
  CAMPO /// campo preenchido (ex.: contato.whatsapp_e164, negocio.dispositivo_id)
  TAREFA /// tarefa concluída (criada automaticamente ao entrar na etapa)
  REGRA /// chave de regra implementada no código (ex.: orcamento_enviado)
}

/// "O que falta" para SAIR da etapa. Alimenta completude, campos_faltantes e tarefas.
model RequisitoEtapa {
  id            String        @id @default(uuid(7)) @db.Uuid
  etapa_id      String        @db.Uuid
  tipo          TipoRequisito
  chave         String
  descricao     String /// "Identificar o dispositivo"
  obrigatorio   Boolean       @default(true) /// false = só pesa na completude
  ordem         Int           @default(0)
  titulo_tarefa String?

  etapa   EtapaFunil @relation(fields: [etapa_id], references: [id], onDelete: Cascade)
  tarefas Tarefa[]

  @@map("requisito_etapa")
}

enum InteresseNegocio {
  REPARO
  DIAGNOSTICO
  MANUTENCAO_PREVENTIVA
  RECUPERACAO_DADOS
  UPGRADE
  VENDA_PRODUTO
  OUTRO
}

enum Urgencia {
  BAIXA
  MEDIA
  ALTA
}

enum StatusNegocio {
  ABERTO
  GANHO
  PERDIDO
  NUTRICAO
}

/// Demanda comercial. GANHO = orçamento aprovado convertido em OS.
model Negocio {
  id                  String           @id @default(uuid(7)) @db.Uuid
  tenant_id           String           @db.Uuid
  empresa_id          String           @db.Uuid
  contato_id          String           @db.Uuid
  funil_id            String           @db.Uuid
  etapa_id            String           @db.Uuid
  titulo              String
  interesse           InteresseNegocio @default(REPARO)
  tipo_dispositivo    TipoDispositivo?
  dispositivo_id      String?          @db.Uuid
  descricao_problema  String?
  urgencia            Urgencia?
  valor_estimado      Decimal?         @db.Decimal(14, 2)
  previsao_fechamento DateTime?        @db.Date
  status              StatusNegocio    @default(ABERTO)
  motivo_perda_id     String?          @db.Uuid
  responsavel_id      String?          @db.Uuid
  entrou_etapa_em     DateTime         @default(now())
  fechado_em          DateTime?
  completude          Int              @default(0)
  nba_adiada_ate      DateTime?
  versao_registro     Int              @default(0)
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  deleted_at          DateTime?

  empresa      Empresa      @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  contato      Contato      @relation(fields: [empresa_id, contato_id], references: [empresa_id, id])
  funil        Funil        @relation(fields: [empresa_id, funil_id], references: [empresa_id, id])
  etapa        EtapaFunil   @relation(fields: [funil_id, etapa_id], references: [funil_id, id])
  dispositivo  Dispositivo? @relation(fields: [empresa_id, dispositivo_id], references: [empresa_id, id], onDelete: Restrict)
  motivo_perda MotivoPerda? @relation(fields: [empresa_id, motivo_perda_id], references: [empresa_id, id], onDelete: Restrict)
  responsavel  Membro?      @relation("NegocioResponsavel", fields: [tenant_id, responsavel_id], references: [tenant_id, id], onDelete: Restrict)

  historico_etapas HistoricoEtapaNegocio[]
  atividades       Atividade[]
  tarefas          Tarefa[]
  orcamentos       Orcamento[]
  ordens_servico   OrdemServico[]
  notificacoes     Notificacao[]

  @@unique([empresa_id, id])
  @@index([empresa_id, status, etapa_id])
  @@index([contato_id])
  @@map("negocio")
}

model MotivoPerda {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenant_id  String  @db.Uuid
  empresa_id String  @db.Uuid
  nome       String
  ativo      Boolean @default(true)

  empresa  Empresa   @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  negocios Negocio[]

  @@unique([empresa_id, nome])
  @@unique([empresa_id, id])
  @@map("motivo_perda")
}

model HistoricoEtapaNegocio {
  id                String   @id @default(uuid(7)) @db.Uuid
  negocio_id        String   @db.Uuid
  de_etapa_id       String?  @db.Uuid
  para_etapa_id     String   @db.Uuid
  membro_id         String?  @db.Uuid
  segundos_na_etapa Int?
  ocorreu_em        DateTime @default(now())

  negocio Negocio @relation(fields: [negocio_id], references: [id], onDelete: Cascade)

  @@index([negocio_id, ocorreu_em])
  @@map("historico_etapa_negocio")
}

enum TipoAtividade {
  LIGACAO
  WHATSAPP
  EMAIL
  SMS
  VISITA_LOJA
  REUNIAO
  NOTA
  NOTA_TECNICA /// diário do técnico na bancada (antes: apontamento_os)
  FORMULARIO
  SISTEMA
}

enum DirecaoAtividade {
  ENTRADA
  SAIDA
  INTERNA
}

/// Timeline única de interações (contato, negócio e OS). Também é fonte de
/// eventos de engajamento para o scoring.
model Atividade {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenant_id  String           @db.Uuid
  empresa_id String           @db.Uuid
  contato_id String?          @db.Uuid
  negocio_id String?          @db.Uuid
  os_id      String?          @db.Uuid
  tipo       TipoAtividade
  direcao    DirecaoAtividade @default(INTERNA)
  assunto    String?
  conteudo   String?
  resultado  String? /// atendeu, não atendeu, pediu retorno…
  minutos    Int? /// NOTA_TECNICA: tempo gasto
  membro_id  String?          @db.Uuid
  metadados  Json?
  ocorreu_em DateTime         @default(now())

  empresa Empresa       @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  contato Contato?      @relation(fields: [empresa_id, contato_id], references: [empresa_id, id], onDelete: Restrict)
  negocio Negocio?      @relation(fields: [empresa_id, negocio_id], references: [empresa_id, id], onDelete: Restrict)
  os      OrdemServico? @relation(fields: [empresa_id, os_id], references: [empresa_id, id], onDelete: Restrict)

  @@index([contato_id, ocorreu_em])
  @@index([negocio_id, ocorreu_em])
  @@index([os_id, ocorreu_em])
  @@map("atividade")
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum Prioridade {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

enum OrigemTarefa {
  MANUAL
  REQUISITO_ETAPA
  PROXIMA_ACAO
  AUTOMACAO
}

/// Ações da fila "próximas ações" (calculada por regras no código, sem tabela).
enum TipoAcao {
  LIGAR
  ENVIAR_WHATSAPP
  ENVIAR_EMAIL
  ENVIAR_SMS
  COMPLETAR_PERFIL
  IDENTIFICAR_DISPOSITIVO
  ELABORAR_ORCAMENTO
  FOLLOW_UP_ORCAMENTO
  AGENDAR_ENTRADA
  OFERECER_UPSELL
  REATIVAR_CLIENTE
  PEDIR_AVALIACAO
}

model Tarefa {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenant_id      String       @db.Uuid
  empresa_id     String       @db.Uuid
  contato_id     String?      @db.Uuid
  negocio_id     String?      @db.Uuid
  os_id          String?      @db.Uuid
  titulo         String
  descricao      String?
  status         StatusTarefa @default(PENDENTE)
  prioridade     Prioridade   @default(NORMAL)
  origem         OrigemTarefa @default(MANUAL)
  requisito_id   String?      @db.Uuid
  acao           TipoAcao? /// quando origem = PROXIMA_ACAO
  regra_chave    String? /// regra de próxima ação que originou (código)
  vence_em       DateTime?
  responsavel_id String?      @db.Uuid
  concluida_em   DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  empresa     Empresa         @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  contato     Contato?        @relation(fields: [empresa_id, contato_id], references: [empresa_id, id], onDelete: Restrict)
  negocio     Negocio?        @relation(fields: [empresa_id, negocio_id], references: [empresa_id, id], onDelete: Restrict)
  os          OrdemServico?   @relation(fields: [empresa_id, os_id], references: [empresa_id, id], onDelete: Restrict)
  requisito   RequisitoEtapa? @relation(fields: [requisito_id], references: [id], onDelete: SetNull)
  responsavel Membro?         @relation("TarefaResponsavel", fields: [tenant_id, responsavel_id], references: [tenant_id, id], onDelete: Restrict)

  @@index([empresa_id, responsavel_id, status, vence_em])
  @@map("tarefa")
}

// =============================================================================
// 3. DISPOSITIVOS, ACESSÓRIOS E CHECKLISTS
// =============================================================================

enum TipoDispositivo {
  CELULAR
  TABLET
  NOTEBOOK
  DESKTOP
  ALL_IN_ONE
  OUTRO
}

enum StatusDispositivo {
  ATIVO
  INATIVO
  DESCARTADO
}

/// Base comum (Ogun: Celular + Notebook). Campos pesquisáveis são colunas;
/// specs por tipo ficam em `especificacoes` (JSONB validado por Zod por tipo):
///  CELULAR/TABLET: {sistema_operacional, versao_so, saude_bateria_pct, dual_chip, esim}
///  NOTEBOOK/DESKTOP/ALL_IN_ONE: {familia_linha, sku_fabricante, processador, arquitetura,
///    memoria_ram_gb, tipo_armazenamento, capacidade_armazenamento, gpu_tipo, gpu_marca,
///    gpu_modelo, sistema_operacional, potencia_fonte_watts}
/// Não guarda senha/padrão de desbloqueio: o cliente remove o bloqueio ao
/// entregar o aparelho (registrado em inspecao.bloqueio_removido).
model Dispositivo {
  id                    String            @id @default(uuid(7)) @db.Uuid
  tenant_id             String            @db.Uuid
  empresa_id            String            @db.Uuid
  tipo                  TipoDispositivo
  marca                 String?
  modelo                String?
  cor                   String?
  numero_serie          String?
  imei                  String?
  imei_2                String?
  armazenamento_gb      Int?
  especificacoes        Json              @default("{}")
  proprietario_atual_id String?           @db.Uuid
  status                StatusDispositivo @default(ATIVO)
  observacoes           String?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  deleted_at            DateTime?

  empresa            Empresa  @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  proprietario_atual Contato? @relation(fields: [empresa_id, proprietario_atual_id], references: [empresa_id, id], onDelete: Restrict)

  proprietarios DispositivoProprietario[]
  eventos       DispositivoEvento[]
  negocios      Negocio[]
  inspecoes     Inspecao[]
  orcamentos    Orcamento[]
  ordens        OrdemServico[]
  anexos        Anexo[]

  @@unique([empresa_id, id])
  @@index([empresa_id, imei])
  @@index([empresa_id, numero_serie])
  @@index([proprietario_atual_id])
  @@map("dispositivo")
}

/// Histórico de posse. No máximo um registro aberto (ate IS NULL) por dispositivo
/// — índice único parcial na migração.
model DispositivoProprietario {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenant_id      String    @db.Uuid
  empresa_id     String    @db.Uuid
  dispositivo_id String    @db.Uuid
  contato_id     String    @db.Uuid
  desde          DateTime  @default(now())
  ate            DateTime?

  empresa     Empresa     @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  dispositivo Dispositivo @relation(fields: [empresa_id, dispositivo_id], references: [empresa_id, id], onDelete: Cascade)
  contato     Contato     @relation(fields: [empresa_id, contato_id], references: [empresa_id, id])

  @@index([dispositivo_id, desde])
  @@map("dispositivo_proprietario")
}

enum TipoEventoDispositivo {
  CADASTRO
  ENTRADA
  INSPECAO
  DIAGNOSTICO
  ORCAMENTO
  PECA_SUBSTITUIDA
  SERVICO_EXECUTADO
  TESTE_QUALIDADE
  SAIDA
  RETORNO_GARANTIA
  TROCA_PROPRIETARIO
  OBSERVACAO
}

/// Prontuário técnico (append-only). Escrito pelos comandos de domínio de
/// orçamento/OS/estoque e manualmente via "observação". Não contém dados
/// pessoais do proprietário — só referências.
model DispositivoEvento {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenant_id      String                @db.Uuid
  empresa_id     String                @db.Uuid
  dispositivo_id String                @db.Uuid
  tipo           TipoEventoDispositivo
  descricao      String
  os_id          String?               @db.Uuid
  orcamento_id   String?               @db.Uuid
  item_id        String?               @db.Uuid /// peça aplicada
  membro_id      String?               @db.Uuid
  dados          Json?
  ocorreu_em     DateTime              @default(now())

  empresa     Empresa       @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  dispositivo Dispositivo   @relation(fields: [empresa_id, dispositivo_id], references: [empresa_id, id], onDelete: Cascade)
  os          OrdemServico? @relation(fields: [empresa_id, os_id], references: [empresa_id, id], onDelete: Restrict)
  orcamento   Orcamento?    @relation(fields: [empresa_id, orcamento_id], references: [empresa_id, id], onDelete: Restrict)
  item        Item?         @relation(fields: [empresa_id, item_id], references: [empresa_id, id], onDelete: Restrict)

  @@index([dispositivo_id, ocorreu_em])
  @@map("dispositivo_evento")
}

enum CategoriaAcessorio {
  ALIMENTACAO
  CONECTIVIDADE
  PROTECAO
  ARMAZENAMENTO
  PERIFERICO
  OUTRO
}

/// Ogun: Tipo Acessorio (as flags definem quais atributos o acessório exibe).
model TipoAcessorio {
  id                        String             @id @default(uuid(7)) @db.Uuid
  tenant_id                 String             @db.Uuid
  nome                      String
  categoria                 CategoriaAcessorio
  tem_padrao_tomada         Boolean            @default(false)
  tem_tipo_conector         Boolean            @default(false)
  tem_potencia_watts        Boolean            @default(false)
  tem_capacidade            Boolean            @default(false)
  tem_classe_velocidade     Boolean            @default(false)
  tem_conectividade_sem_fio Boolean            @default(false)
  tem_layout                Boolean            @default(false)
  ativo                     Boolean            @default(true)

  tenant    Tenant              @relation(fields: [tenant_id], references: [id])
  recebidos AcessorioRecebido[]

  @@unique([tenant_id, nome])
  @@unique([tenant_id, id])
  @@map("tipo_acessorio")
}

enum PadraoTomada {
  TIPO_A
  TIPO_C
  TIPO_N
}

enum TipoConector {
  USB_C
  USB_A
  MICRO_USB
  LIGHTNING
  P2
  THUNDERBOLT_3
  THUNDERBOLT_4
  USB3_TIPO_B
  MAGSAFE
  PROPRIETARIO
  SD
  MICRO_SD
}

enum ClasseVelocidade {
  CLASSE_4
  CLASSE_6
  CLASSE_10
  UHS_I_U1
  UHS_I_U3
  UHS_II
  UHS_III
  V30
  V60
  V90
}

enum Conectividade {
  COM_FIO
  BLUETOOTH
  DONGLE_2_4GHZ
  BLUETOOTH_E_2_4GHZ
}

enum LayoutTeclado {
  ABNT2
  US_INTERNACIONAL
  UK
  OUTRO
}

/// Ogun: Acessorio Cliente — ligado a orçamento OU OS (CHECK na migração),
/// com controle de devolução na entrega.
model AcessorioRecebido {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenant_id         String            @db.Uuid
  empresa_id        String            @db.Uuid
  orcamento_id      String?           @db.Uuid
  os_id             String?           @db.Uuid
  tipo_acessorio_id String            @db.Uuid
  padrao_tomada     PadraoTomada?
  tipo_conector     TipoConector?
  potencia_watts    Int?
  capacidade        String?
  classe_velocidade ClasseVelocidade?
  conectividade     Conectividade?
  layout_teclado    LayoutTeclado?
  cor               String?
  detalhes          String?
  devolvido_em      DateTime?

  empresa        Empresa       @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  tipo_acessorio TipoAcessorio @relation(fields: [tenant_id, tipo_acessorio_id], references: [tenant_id, id])
  orcamento      Orcamento?    @relation(fields: [empresa_id, orcamento_id], references: [empresa_id, id], onDelete: Cascade)
  os             OrdemServico? @relation(fields: [empresa_id, os_id], references: [empresa_id, id], onDelete: Cascade)

  @@map("acessorio_recebido")
}

enum MomentoInspecao {
  ENTRADA
  SAIDA
}

/// Checklist configurável por tipo de dispositivo e momento. `itens` (JSONB):
/// [{chave, rotulo, tipo_resposta: BOOLEANO|OPCOES|TEXTO|NUMERO, opcoes[],
///   obrigatorio, depende_de: {chave, igual}}]
/// O modelo padrão de CELULAR replica o Ogun: liga_normalmente, tela, display,
/// toque, bateria, áudio, câmera traseira/frontal.
model ChecklistModelo {
  id               String          @id @default(uuid(7)) @db.Uuid
  tenant_id        String          @db.Uuid
  nome             String
  tipo_dispositivo TipoDispositivo
  momento          MomentoInspecao
  versao           Int             @default(1)
  itens            Json
  ativo            Boolean         @default(true)

  tenant    Tenant     @relation(fields: [tenant_id], references: [id])
  inspecoes Inspecao[]

  @@unique([tenant_id, id])
  @@map("checklist_modelo")
}

/// Inspeção de entrada/saída + termo de responsabilidade.
/// `itens_snapshot` congela o checklist usado; `respostas` = {chave: valor}.
model Inspecao {
  id                  String          @id @default(uuid(7)) @db.Uuid
  tenant_id           String          @db.Uuid
  empresa_id          String          @db.Uuid
  dispositivo_id      String          @db.Uuid
  orcamento_id        String?         @db.Uuid
  os_id               String?         @db.Uuid
  modelo_id           String?         @db.Uuid
  momento             MomentoInspecao
  itens_snapshot      Json
  respostas           Json            @default("{}")
  estado_externo      String /// obrigatório (Ogun: reqd)
  liga_normalmente    Boolean?
  /// Política: o cliente remove senha/padrão/biometria ao entregar o aparelho.
  /// ENTRADA exige true ou bloqueio_observacao (ex.: "aparelho não liga").
  bloqueio_removido   Boolean         @default(false)
  bloqueio_observacao String?
  observacoes         String?
  // --- termo de responsabilidade ---
  termo_versao        String? /// versão do texto aceito
  termo_aceito_em     DateTime?
  termo_aceito_por    String? /// nome de quem aceitou (cliente ou portador)
  termo_canal         CanalDecisao?
  realizada_por       String?         @db.Uuid
  realizada_em        DateTime        @default(now())

  empresa     Empresa          @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  dispositivo Dispositivo      @relation(fields: [empresa_id, dispositivo_id], references: [empresa_id, id])
  orcamento   Orcamento?       @relation(fields: [empresa_id, orcamento_id], references: [empresa_id, id], onDelete: Restrict)
  os          OrdemServico?    @relation(fields: [empresa_id, os_id], references: [empresa_id, id], onDelete: Restrict)
  modelo      ChecklistModelo? @relation(fields: [tenant_id, modelo_id], references: [tenant_id, id], onDelete: Restrict)

  @@index([os_id, momento])
  @@map("inspecao")
}

// =============================================================================
// 4. ORÇAMENTO (conversão) E BANCADA (ordens de serviço)
// =============================================================================

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  VISUALIZADO
  APROVADO
  APROVADO_PARCIAL
  REPROVADO
  EXPIRADO
  CANCELADO /// inclui versão substituída por revisão
  CONVERTIDO
}

enum CanalDecisao {
  LINK_PUBLICO
  WHATSAPP
  PRESENCIAL
  TELEFONE
  EMAIL
}

enum CanalEntrada {
  BALCAO
  SITE
  WHATSAPP
  TELEFONE
  COLETA
}

/// Ogun: Orcamento. Cada VERSÃO é uma linha (mesmo `numero`, `versao` crescente).
/// Imutável após ENVIADO (itens e valores); alteração = nova versão e a anterior
/// vira CANCELADO. Uma única versão não cancelada por número (índice parcial).
/// Dispositivo opcional: permite orçamento remoto.
model Orcamento {
  id                  String          @id @default(uuid(7)) @db.Uuid
  tenant_id           String          @db.Uuid
  empresa_id          String          @db.Uuid
  numero              String
  versao              Int             @default(1)
  orcamento_pai_id    String?         @db.Uuid
  contato_id          String          @db.Uuid
  negocio_id          String?         @db.Uuid
  tipo_dispositivo    TipoDispositivo
  dispositivo_id      String?         @db.Uuid
  canal_entrada       CanalEntrada    @default(BALCAO)
  descricao_problema  String
  diagnostico         String?
  status              StatusOrcamento @default(RASCUNHO)
  validade            DateTime        @db.Date
  prazo_execucao_dias Int?
  garantia_dias       Int?
  subtotal            Decimal         @default(0) @db.Decimal(14, 2)
  desconto            Decimal         @default(0) @db.Decimal(14, 2)
  total               Decimal         @default(0) @db.Decimal(14, 2)
  total_aprovado      Decimal?        @db.Decimal(14, 2)
  condicoes           String?
  observacoes         String?
  token_publico       String          @unique /// link de visualização/aprovação desta versão
  enviado_em          DateTime?
  visualizado_em      DateTime?
  decidido_em         DateTime?
  decidido_via        CanalDecisao?
  decisao_evidencia   Json? /// ip, user-agent, nome digitado, membro que registrou
  motivo_reprovacao   String?
  responsavel_id      String?         @db.Uuid
  criado_por          String?         @db.Uuid
  versao_registro     Int             @default(0)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  deleted_at          DateTime?

  empresa       Empresa      @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  contato       Contato      @relation(fields: [empresa_id, contato_id], references: [empresa_id, id])
  negocio       Negocio?     @relation(fields: [empresa_id, negocio_id], references: [empresa_id, id], onDelete: Restrict)
  dispositivo   Dispositivo? @relation(fields: [empresa_id, dispositivo_id], references: [empresa_id, id], onDelete: Restrict)
  orcamento_pai Orcamento?   @relation("RevisaoOrcamento", fields: [empresa_id, orcamento_pai_id], references: [empresa_id, id], onDelete: Restrict)
  revisoes      Orcamento[]  @relation("RevisaoOrcamento")

  itens         OrcamentoItem[]
  acessorios    AcessorioRecebido[]
  inspecoes     Inspecao[]
  historico     OrcamentoStatusHistorico[]
  ordem_servico OrdemServico?
  eventos_disp  DispositivoEvento[]
  notificacoes  Notificacao[]
  anexos        Anexo[]

  @@unique([empresa_id, numero, versao])
  @@unique([empresa_id, id])
  @@index([empresa_id, status, validade])
  @@index([contato_id])
  @@map("orcamento")
}

model OrcamentoStatusHistorico {
  id           String           @id @default(uuid(7)) @db.Uuid
  orcamento_id String           @db.Uuid
  de_status    StatusOrcamento?
  para_status  StatusOrcamento
  membro_id    String?          @db.Uuid
  observacao   String?
  ocorreu_em   DateTime         @default(now())

  orcamento Orcamento @relation(fields: [orcamento_id], references: [id], onDelete: Cascade)

  @@index([orcamento_id, ocorreu_em])
  @@map("orcamento_status_historico")
}

enum TipoItem {
  PRODUTO
  SERVICO
}

/// Ogun: Item Fluxo (linha de orçamento).
model OrcamentoItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenant_id      String   @db.Uuid
  empresa_id     String   @db.Uuid
  orcamento_id   String   @db.Uuid
  item_id        String?  @db.Uuid /// nulo = item avulso
  tipo           TipoItem
  descricao      String
  quantidade     Decimal  @default(1) @db.Decimal(14, 3)
  preco_unitario Decimal  @db.Decimal(14, 2)
  desconto       Decimal  @default(0) @db.Decimal(14, 2)
  total          Decimal  @db.Decimal(14, 2)
  custo_unitario Decimal? @db.Decimal(14, 2) /// snapshot p/ margem prevista
  opcional       Boolean  @default(false)
  aprovado       Boolean? /// decisão item a item (aprovação parcial)
  ordem          Int      @default(0)

  empresa   Empresa   @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  orcamento Orcamento @relation(fields: [empresa_id, orcamento_id], references: [empresa_id, id], onDelete: Cascade)
  item      Item?     @relation(fields: [empresa_id, item_id], references: [empresa_id, id], onDelete: Restrict)

  @@index([orcamento_id])
  @@map("orcamento_item")
}

enum StatusOS {
  ABERTA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  AGUARDANDO_PECAS
  EM_REPARO
  EM_TESTES
  PRONTA
  ENTREGUE
  SEM_REPARO /// devolvida sem conserto
  CANCELADA
}

enum TipoOS {
  REPARO
  GARANTIA
  MANUTENCAO_PREVENTIVA
  CORTESIA
}

/// Ogun: Ordem De Servico. Nasce de orçamento aprovado (orcamento_id, 1:1) ou
/// direto na bancada. Transições só pelo comando de domínio (invariantes OS-*).
model OrdemServico {
  id                   String       @id @default(uuid(7)) @db.Uuid
  tenant_id            String       @db.Uuid
  empresa_id           String       @db.Uuid
  numero               String
  tipo                 TipoOS       @default(REPARO)
  contato_id           String       @db.Uuid
  dispositivo_id       String       @db.Uuid
  orcamento_id         String?      @db.Uuid /// 1 orçamento → no máximo 1 OS
  negocio_id           String?      @db.Uuid
  os_origem_id         String?      @db.Uuid /// retorno em garantia
  status               StatusOS     @default(ABERTA)
  prioridade           Prioridade   @default(NORMAL)
  canal_entrada        CanalEntrada @default(BALCAO)
  descricao_problema   String
  diagnostico_tecnico  String?
  solucao_aplicada     String?
  tecnico_id           String?      @db.Uuid
  local_bancada        String?
  prazo                DateTime
  recebido_em          DateTime     @default(now())
  iniciado_em          DateTime?
  concluido_em         DateTime?
  entregue_em          DateTime?
  entregue_a           String? /// nome de quem retirou
  garantia_dias        Int?
  garantia_ate         DateTime?    @db.Date
  subtotal             Decimal      @default(0) @db.Decimal(14, 2)
  desconto             Decimal      @default(0) @db.Decimal(14, 2)
  total                Decimal      @default(0) @db.Decimal(14, 2)
  custo_total          Decimal      @default(0) @db.Decimal(14, 2) /// peças ao custo médio
  observacoes_internas String?
  criado_por           String?      @db.Uuid
  versao_registro      Int          @default(0)
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt
  deleted_at           DateTime?

  empresa     Empresa        @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  contato     Contato        @relation(fields: [empresa_id, contato_id], references: [empresa_id, id])
  dispositivo Dispositivo    @relation(fields: [empresa_id, dispositivo_id], references: [empresa_id, id])
  orcamento   Orcamento?     @relation(fields: [empresa_id, orcamento_id], references: [empresa_id, id], onDelete: Restrict)
  negocio     Negocio?       @relation(fields: [empresa_id, negocio_id], references: [empresa_id, id], onDelete: Restrict)
  tecnico     Membro?        @relation("OSTecnico", fields: [tenant_id, tecnico_id], references: [tenant_id, id], onDelete: Restrict)
  os_origem   OrdemServico?  @relation("RetornoGarantia", fields: [empresa_id, os_origem_id], references: [empresa_id, id], onDelete: Restrict)
  retornos    OrdemServico[] @relation("RetornoGarantia")

  itens        OrdemServicoItem[]
  acessorios   AcessorioRecebido[]
  inspecoes    Inspecao[]
  historico    OSStatusHistorico[]
  atividades   Atividade[]
  tarefas      Tarefa[]
  titulos      TituloFinanceiro[]
  eventos_disp DispositivoEvento[]
  notificacoes Notificacao[]
  anexos       Anexo[]

  @@unique([empresa_id, numero])
  @@unique([empresa_id, id])
  @@unique([empresa_id, orcamento_id])
  @@index([empresa_id, status, prazo])
  @@index([empresa_id, tecnico_id, status])
  @@index([dispositivo_id])
  @@map("ordem_servico")
}

/// Base de SLA/TAT e gatilho de notificação (o id entra na chave_dedupe).
model OSStatusHistorico {
  id          String    @id @default(uuid(7)) @db.Uuid
  os_id       String    @db.Uuid
  de_status   StatusOS?
  para_status StatusOS
  membro_id   String?   @db.Uuid
  observacao  String?
  notificar   Boolean   @default(true)
  ocorreu_em  DateTime  @default(now())

  os OrdemServico @relation(fields: [os_id], references: [id], onDelete: Cascade)

  @@index([os_id, ocorreu_em])
  @@map("os_status_historico")
}

/// Sem reservas no MVP: a peça sai do estoque quando APLICADA.
enum StatusPeca {
  PENDENTE /// prevista, ainda não aplicada
  A_COMPRAR /// sem saldo; aguardando compra
  APLICADA /// gerou SAIDA_OS no ledger
  DEVOLVIDA /// estornada ao estoque (DEVOLUCAO_CLIENTE / ESTORNO)
}

/// Ogun: Item Fluxo (linha de OS).
model OrdemServicoItem {
  id             String      @id @default(uuid(7)) @db.Uuid
  tenant_id      String      @db.Uuid
  empresa_id     String      @db.Uuid
  os_id          String      @db.Uuid
  item_id        String?     @db.Uuid
  tipo           TipoItem
  descricao      String
  quantidade     Decimal     @default(1) @db.Decimal(14, 3)
  preco_unitario Decimal     @db.Decimal(14, 2)
  desconto       Decimal     @default(0) @db.Decimal(14, 2)
  total          Decimal     @db.Decimal(14, 2)
  custo_unitario Decimal?    @db.Decimal(14, 2) /// custo médio no momento da baixa
  status_peca    StatusPeca? /// só PRODUTO com controle de estoque
  tecnico_id     String?     @db.Uuid /// SERVICO: quem executou
  garantia_dias  Int?
  ordem          Int         @default(0)

  empresa    Empresa            @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  os         OrdemServico       @relation(fields: [empresa_id, os_id], references: [empresa_id, id], onDelete: Cascade)
  item       Item?              @relation(fields: [empresa_id, item_id], references: [empresa_id, id], onDelete: Restrict)
  movimentos MovimentoEstoque[]

  @@unique([empresa_id, id])
  @@index([os_id])
  @@map("ordem_servico_item")
}

enum CategoriaAnexo {
  FOTO_ENTRADA
  FOTO_SAIDA
  FOTO_REPARO
  LAUDO
  NOTA_FISCAL
  TERMO
  OUTRO
}

/// Arquivos (S3/R2). FKs concretas, EXATAMENTE UMA preenchida (CHECK num_nonnulls = 1).
model Anexo {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenant_id      String         @db.Uuid
  empresa_id     String         @db.Uuid
  contato_id     String?        @db.Uuid
  orcamento_id   String?        @db.Uuid
  os_id          String?        @db.Uuid
  dispositivo_id String?        @db.Uuid
  compra_id      String?        @db.Uuid
  categoria      CategoriaAnexo @default(OUTRO)
  nome           String
  mime           String
  tamanho_bytes  Int
  storage_key    String
  publico        Boolean        @default(false) /// visível no link do cliente
  enviado_por    String?        @db.Uuid
  created_at     DateTime       @default(now())

  empresa     Empresa       @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  contato     Contato?      @relation(fields: [empresa_id, contato_id], references: [empresa_id, id], onDelete: Restrict)
  orcamento   Orcamento?    @relation(fields: [empresa_id, orcamento_id], references: [empresa_id, id], onDelete: Restrict)
  os          OrdemServico? @relation(fields: [empresa_id, os_id], references: [empresa_id, id], onDelete: Restrict)
  dispositivo Dispositivo?  @relation(fields: [empresa_id, dispositivo_id], references: [empresa_id, id], onDelete: Restrict)
  compra      Compra?       @relation(fields: [empresa_id, compra_id], references: [empresa_id, id], onDelete: Restrict)

  @@index([os_id])
  @@index([orcamento_id])
  @@index([dispositivo_id])
  @@map("anexo")
}

// =============================================================================
// 5. ESTOQUE, COMPRAS E FINANCEIRO (gerencial)
// -----------------------------------------------------------------------------
// Usuário: "Comprei / Usei / Ajustei / Devolvi". Por baixo: ledger com custo
// médio ponderado móvel por empresa; cache em item atualizado por UPDATE
// condicional na mesma transação do movimento (invariantes EST-*).
// =============================================================================

model Fornecedor {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenant_id          String    @db.Uuid
  empresa_id         String    @db.Uuid
  nome               String
  documento          String?
  contato_nome       String?
  email              String?
  telefone           String?
  site               String?
  prazo_entrega_dias Int?
  observacoes        String?
  ativo              Boolean   @default(true)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  empresa Empresa            @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  itens   Item[]
  compras Compra[]
  titulos TituloFinanceiro[]

  @@unique([empresa_id, id])
  @@map("fornecedor")
}

/// Produto (peça/acessório) ou serviço (mão de obra).
/// estoque_atual/custo_medio: cache do ledger (CHECK estoque_atual >= 0).
/// Mudança de preço registrada no audit_log.
model Item {
  id                   String    @id @default(uuid(7)) @db.Uuid
  tenant_id            String    @db.Uuid
  empresa_id           String    @db.Uuid
  tipo                 TipoItem
  sku                  String?
  nome                 String
  descricao            String?
  categoria            String? /// texto livre no MVP (Telas, Baterias, Mão de obra…)
  unidade              String    @default("UN")
  controla_estoque     Boolean   @default(true) /// SERVICO sempre false
  preco_venda          Decimal   @default(0) @db.Decimal(14, 2)
  preco_compra         Decimal?  @db.Decimal(14, 2) /// último preço pago (informativo)
  custo_medio          Decimal   @default(0) @db.Decimal(14, 4)
  estoque_atual        Decimal   @default(0) @db.Decimal(14, 3)
  estoque_minimo       Decimal   @default(0) @db.Decimal(14, 3)
  fornecedor_padrao_id String?   @db.Uuid
  tempo_estimado_min   Int?
  garantia_dias        Int?
  ativo                Boolean   @default(true)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  deleted_at           DateTime?

  empresa           Empresa     @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  fornecedor_padrao Fornecedor? @relation(fields: [empresa_id, fornecedor_padrao_id], references: [empresa_id, id], onDelete: Restrict)

  linhas_orcamento OrcamentoItem[]
  linhas_os        OrdemServicoItem[]
  linhas_compra    CompraItem[]
  movimentos       MovimentoEstoque[]
  eventos_disp     DispositivoEvento[]

  @@unique([empresa_id, sku])
  @@unique([empresa_id, id])
  @@index([empresa_id, nome])
  @@map("item")
}

enum StatusCompra {
  RASCUNHO
  RECEBIDA /// gera ENTRADA_COMPRA no ledger + título a pagar
  CANCELADA /// após RECEBIDA: estorno de cada movimento
}

/// "Comprei" — entrada de mercadoria. Frete/despesas rateados proporcionalmente
/// ao valor dos itens, de forma SÍNCRONA no recebimento.
model Compra {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenant_id        String       @db.Uuid
  empresa_id       String       @db.Uuid
  numero           String
  fornecedor_id    String?      @db.Uuid
  documento_fiscal String?
  data             DateTime     @db.Date
  status           StatusCompra @default(RASCUNHO)
  frete            Decimal      @default(0) @db.Decimal(14, 2)
  outras_despesas  Decimal      @default(0) @db.Decimal(14, 2)
  total            Decimal      @default(0) @db.Decimal(14, 2)
  observacoes      String?
  criado_por       String?      @db.Uuid
  recebida_em      DateTime?
  versao_registro  Int          @default(0)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  empresa    Empresa            @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  fornecedor Fornecedor?        @relation(fields: [empresa_id, fornecedor_id], references: [empresa_id, id], onDelete: Restrict)
  itens      CompraItem[]
  titulos    TituloFinanceiro[]
  anexos     Anexo[]

  @@unique([empresa_id, numero])
  @@unique([empresa_id, id])
  @@map("compra")
}

model CompraItem {
  id                   String  @id @default(uuid(7)) @db.Uuid
  tenant_id            String  @db.Uuid
  empresa_id           String  @db.Uuid
  compra_id            String  @db.Uuid
  item_id              String  @db.Uuid
  quantidade           Decimal @db.Decimal(14, 3)
  custo_unitario       Decimal @db.Decimal(14, 2) /// preço pago
  custo_unitario_final Decimal @default(0) @db.Decimal(14, 4) /// + rateio (preenchido no recebimento)
  total                Decimal @db.Decimal(14, 2)

  empresa    Empresa            @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  compra     Compra             @relation(fields: [empresa_id, compra_id], references: [empresa_id, id], onDelete: Cascade)
  item       Item               @relation(fields: [empresa_id, item_id], references: [empresa_id, id])
  movimentos MovimentoEstoque[]

  @@unique([empresa_id, id])
  @@map("compra_item")
}

enum TipoMovimento {
  ENTRADA_COMPRA
  SAIDA_OS
  DEVOLUCAO_CLIENTE /// peça aplicada que voltou (OS cancelada/garantia)
  DEVOLUCAO_FORNECEDOR
  AJUSTE_ENTRADA /// contagem achou a mais
  AJUSTE_SAIDA /// contagem achou a menos
  PERDA /// quebra/defeito/uso interno
  ESTORNO
}

/// Ledger imutável (ERPNext: Stock Ledger Entry). `chave_operacao` torna cada
/// efeito idempotente (ex.: "SAIDA_OS:<os_item_id>", "ENTRADA:<compra_item_id>").
model MovimentoEstoque {
  id                     String        @id @default(uuid(7)) @db.Uuid
  tenant_id              String        @db.Uuid
  empresa_id             String        @db.Uuid
  item_id                String        @db.Uuid
  tipo                   TipoMovimento
  chave_operacao         String
  quantidade             Decimal       @db.Decimal(14, 3) /// + entrada / − saída
  custo_unitario         Decimal       @db.Decimal(14, 4)
  valor_total            Decimal       @db.Decimal(14, 2)
  saldo_apos             Decimal       @db.Decimal(14, 3)
  custo_medio_apos       Decimal       @db.Decimal(14, 4)
  compra_item_id         String?       @db.Uuid
  os_item_id             String?       @db.Uuid
  movimento_estornado_id String?       @db.Uuid
  motivo                 String?
  membro_id              String?       @db.Uuid
  ocorreu_em             DateTime      @default(now())

  empresa     Empresa           @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  item        Item              @relation(fields: [empresa_id, item_id], references: [empresa_id, id])
  compra_item CompraItem?       @relation(fields: [empresa_id, compra_item_id], references: [empresa_id, id], onDelete: Restrict)
  os_item     OrdemServicoItem? @relation(fields: [empresa_id, os_item_id], references: [empresa_id, id], onDelete: Restrict)
  estornado   MovimentoEstoque? @relation("Estorno", fields: [empresa_id, movimento_estornado_id], references: [empresa_id, id], onDelete: Restrict)
  estorno     MovimentoEstoque? @relation("Estorno")

  @@unique([empresa_id, chave_operacao])
  @@unique([empresa_id, id])
  @@unique([empresa_id, movimento_estornado_id])
  @@index([item_id, ocorreu_em])
  @@index([empresa_id, tipo, ocorreu_em])
  @@map("movimento_estoque")
}

enum TipoTitulo {
  PAGAR
  RECEBER
}

enum StatusTitulo {
  ABERTO
  PARCIAL
  PAGO
  CANCELADO
}

enum CategoriaFinanceira {
  RECEITA_SERVICO
  RECEITA_PRODUTO
  COMPRA_MERCADORIA
  DESPESA_OPERACIONAL
  OUTRA
}

/// Contas a pagar/receber (gerencial). RECEBER: um título por OS (índice parcial),
/// criado na abertura/aprovação; sinal e parcelas são pagamentos nesse título.
/// PAGAR: um ou mais títulos por compra (parcelas do fornecedor).
model TituloFinanceiro {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenant_id     String              @db.Uuid
  empresa_id    String              @db.Uuid
  tipo          TipoTitulo
  categoria     CategoriaFinanceira
  descricao     String
  contato_id    String?             @db.Uuid
  fornecedor_id String?             @db.Uuid
  compra_id     String?             @db.Uuid
  os_id         String?             @db.Uuid
  valor         Decimal             @db.Decimal(14, 2)
  valor_pago    Decimal             @default(0) @db.Decimal(14, 2) /// soma líquida dos pagamentos
  vencimento    DateTime            @db.Date
  status        StatusTitulo        @default(ABERTO)
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt

  empresa    Empresa       @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  contato    Contato?      @relation(fields: [empresa_id, contato_id], references: [empresa_id, id], onDelete: Restrict)
  fornecedor Fornecedor?   @relation(fields: [empresa_id, fornecedor_id], references: [empresa_id, id], onDelete: Restrict)
  compra     Compra?       @relation(fields: [empresa_id, compra_id], references: [empresa_id, id], onDelete: Restrict)
  os         OrdemServico? @relation(fields: [empresa_id, os_id], references: [empresa_id, id], onDelete: Restrict)
  pagamentos Pagamento[]

  @@unique([empresa_id, id])
  @@index([empresa_id, tipo, status, vencimento])
  @@map("titulo_financeiro")
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
  OUTRO
}

enum TipoLancamentoPagamento {
  PAGAMENTO
  ESTORNO /// valor negativo, aponta o pagamento estornado
}

/// Append-only. Estorno = nova linha (valor negativo) ligada ao pagamento original.
model Pagamento {
  id                     String                  @id @default(uuid(7)) @db.Uuid
  tenant_id              String                  @db.Uuid
  empresa_id             String                  @db.Uuid
  titulo_id              String                  @db.Uuid
  tipo                   TipoLancamentoPagamento @default(PAGAMENTO)
  valor                  Decimal                 @db.Decimal(14, 2)
  forma                  FormaPagamento
  parcelas               Int                     @default(1)
  taxa                   Decimal                 @default(0) @db.Decimal(14, 2) /// taxa de maquininha
  referencia_externa     String?
  pagamento_estornado_id String?                 @db.Uuid
  membro_id              String?                 @db.Uuid
  pago_em                DateTime                @default(now())

  empresa   Empresa          @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  titulo    TituloFinanceiro @relation(fields: [empresa_id, titulo_id], references: [empresa_id, id])
  estornado Pagamento?       @relation("EstornoPagamento", fields: [empresa_id, pagamento_estornado_id], references: [empresa_id, id], onDelete: Restrict)
  estorno   Pagamento?       @relation("EstornoPagamento")

  @@unique([empresa_id, id])
  @@unique([empresa_id, pagamento_estornado_id])
  @@index([titulo_id])
  @@map("pagamento")
}

// =============================================================================
// 6. NOTIFICAÇÕES (WhatsApp / e-mail / SMS) — padrão Outbox
// =============================================================================

enum EventoNotificacao {
  ORCAMENTO_ENVIADO
  ORCAMENTO_APROVADO
  ORCAMENTO_REPROVADO
  ORCAMENTO_EXPIRANDO
  OS_ABERTA
  OS_STATUS_ALTERADO
  OS_AGUARDANDO_APROVACAO
  OS_AGUARDANDO_PECAS
  OS_PRONTA
  OS_ENTREGUE
  GARANTIA_EXPIRANDO
  LEAD_FOLLOW_UP
  PESQUISA_SATISFACAO
}

/// Conteúdo por evento × canal. `ativo` liga/desliga o evento naquele canal.
/// WhatsApp fora da janela de 24h exige template aprovado pela Meta.
model ModeloMensagem {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenant_id         String            @db.Uuid
  empresa_id        String            @db.Uuid
  evento            EventoNotificacao
  canal             CanalComunicacao
  assunto           String? /// e-mail
  corpo             String /// Handlebars: {{contato.nome}}, {{os.numero}}, {{link}}
  whatsapp_template String?
  whatsapp_idioma   String?           @default("pt_BR")
  status_os         StatusOS[] /// OS_STATUS_ALTERADO: quais status disparam
  ativo             Boolean           @default(true)

  empresa      Empresa       @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  notificacoes Notificacao[]

  @@unique([empresa_id, evento, canal])
  @@unique([empresa_id, id])
  @@map("modelo_mensagem")
}

enum StatusNotificacao {
  PENDENTE
  ENVIANDO
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
  CANCELADA
}

/// Outbox: criada na MESMA transação da mudança de status. Worker envia com
/// retry e fallback de canal; webhooks do provedor atualizam o status.
model Notificacao {
  id              String            @id @default(uuid(7)) @db.Uuid
  tenant_id       String            @db.Uuid
  empresa_id      String            @db.Uuid
  contato_id      String            @db.Uuid
  orcamento_id    String?           @db.Uuid
  os_id           String?           @db.Uuid
  negocio_id      String?           @db.Uuid
  evento          EventoNotificacao
  canal           CanalComunicacao
  chave_dedupe    String /// ex.: "OS_STATUS_ALTERADO:<os_status_historico.id>:WHATSAPP"
  destino         String /// e164 ou e-mail resolvido no envio
  modelo_id       String?           @db.Uuid
  variaveis       Json
  conteudo        String?
  status          StatusNotificacao @default(PENDENTE)
  tentativas      Int               @default(0)
  provedor        String?
  provedor_msg_id String?
  erro            String?
  agendada_para   DateTime          @default(now())
  enviada_em      DateTime?
  entregue_em     DateTime?
  lida_em         DateTime?
  created_at      DateTime          @default(now())

  empresa   Empresa         @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])
  contato   Contato         @relation(fields: [empresa_id, contato_id], references: [empresa_id, id])
  orcamento Orcamento?      @relation(fields: [empresa_id, orcamento_id], references: [empresa_id, id], onDelete: Restrict)
  os        OrdemServico?   @relation(fields: [empresa_id, os_id], references: [empresa_id, id], onDelete: Restrict)
  negocio   Negocio?        @relation(fields: [empresa_id, negocio_id], references: [empresa_id, id], onDelete: Restrict)
  modelo    ModeloMensagem? @relation(fields: [empresa_id, modelo_id], references: [empresa_id, id], onDelete: Restrict)

  @@unique([empresa_id, chave_dedupe])
  @@unique([provedor, provedor_msg_id])
  @@index([status, agendada_para])
  @@index([os_id])
  @@index([orcamento_id])
  @@map("notificacao")
}

// =============================================================================
// 7. OPERAÇÕES EM MASSA
// =============================================================================

enum TipoJobLote {
  LEAD_CRIAR
  LEAD_ATUALIZAR
  LEAD_EXCLUIR
  LEAD_IMPORTAR_CSV
  ITEM_IMPORTAR_CSV
}

enum StatusJob {
  NA_FILA
  PROCESSANDO
  CONCLUIDO
  CONCLUIDO_COM_ERROS
  FALHOU
}

/// Lotes > 500 linhas ou CSV: API devolve 202 + job_id. Cada linha é processada
/// em sua própria transação (política: sucesso parcial, erros por linha).
model JobLote {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenant_id       String      @db.Uuid
  empresa_id      String      @db.Uuid
  tipo            TipoJobLote
  status          StatusJob   @default(NA_FILA)
  total           Int         @default(0)
  processados     Int         @default(0)
  sucesso         Int         @default(0)
  falhas          Int         @default(0)
  parametros      Json /// filtro, patch, opções de dedupe
  erros           Json? /// [{linha, campo, mensagem}]
  arquivo_key     String?
  idempotency_key String?
  criado_por      String?     @db.Uuid
  created_at      DateTime    @default(now())
  finalizado_em   DateTime?

  empresa Empresa @relation(fields: [tenant_id, empresa_id], references: [tenant_id, id])

  @@unique([empresa_id, idempotency_key])
  @@map("job_lote")
}
