{
  "name": "@ebisu/db",
  "version": "0.0.0",
  "private": true,
  "description": "Schema Prisma, migrações, papéis de banco, seeds e cliente com tenancy (F1)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "test": "prisma generate && vitest run",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "papeis": "node scripts/configurar-papeis.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "prisma": "6.19.3",
    "testcontainers": "^12.2.1"
  }
}
