{
  "name": "ebisu-crm",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:invariantes": "./scripts/db-invariantes.sh",
    "db:migrate": "pnpm --filter @ebisu/db migrate:deploy",
    "db:papeis": "pnpm --filter @ebisu/db papeis"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
